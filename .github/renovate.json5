{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // This repo's Renovate config pulls the shared policy from the
  // renovate-config.json5 preset in tbhb-dev/devtools via extends — the
  // repository-level rules, the grouping rules, and the custom managers
  // covering the pin sites no built-in manager reads: the vale package
  // pins in .vale.ini, the apm.yml dependency, and the extends pin
  // below. Nothing stays inline here.
  //
  // The global-only options (identity, rate limits, requireConfig) are
  // inlined below instead of using globalExtends: Renovate resolves
  // globalExtends presets before hostRules are registered, so the preset
  // fetch is always anonymous and intermittently hits GitHub's per-IP
  // anonymous rate limit on shared runners (config-presets-invalid).
  // extends is resolved after platform init with token auth, so it is
  // unaffected.
  requireConfig: "ignored",
  username: "tbhb-renovate[bot]",
  gitAuthor: "tbhb-renovate[bot] <311633125+tbhb-renovate[bot]@users.noreply.github.com>",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  // Pinned to a commit rather than the default branch, so the one file
  // governing every other pin answers to the same discipline. The
  // trailing comment is the only human-readable version at this site,
  // and `mise run devtools:check-pins` reads it.
  extends: [
    "github>tbhb-dev/devtools//.github/renovate-config.json5#1621e6a9e8416bf801732996a104a3b5b7a99fdb", // v0.22.1
  ],

  // Single-repo scope. Differs per repo.
  repositories: ["tbhb/vale-ai-tells"],
}
